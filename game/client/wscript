#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os
import vpc_parser

top = '.'
PROJECT_NAME = 'client'

def options(opt):
	return

games = {
	'hl2': ['client_base.vpc', 'client_hl2.vpc'],
	'hl2mp': ['client_base.vpc', 'client_hl2mp.vpc'],
	'hl1': ['client_base.vpc', 'client_hl1.vpc'],
	'episodic': ['client_base.vpc', 'client_episodic.vpc'],
	'portal': ['client_base.vpc', 'client_portal.vpc'],
	'hl1mp': ['client_base.vpc', 'client_hl1mp.vpc'],
	'cstrike': ['client_base.vpc', 'client_cstrike.vpc'],
	'dod': ['client_base.vpc', 'client_dod.vpc'],
	'lostcoast': ['client_base.vpc', 'client_lostcoast.vpc']
}

def resolve_game_list(raw_games):
	if raw_games == 'all':
		return list(games.keys())
	return [g.strip() for g in raw_games.split(',') if g.strip()]

def configure(conf):
	game = conf.options.GAMES
	conf.env.GAMES = game

	conf.env.append_unique('DEFINES', ['DISABLE_STEAM=1'])

	for g in resolve_game_list(game):
		if g not in games:
			conf.fatal("Couldn't find game: " + g)

def build(bld):
	game_list = resolve_game_list(bld.env.GAMES)
	multi = len(game_list) > 1

	base_includes = [
		'.',
		'game_controls',
		'../../common',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../vgui2/include',
		'../../vgui2/controls',
		'../shared'
	]

	base_libs = [
		'tier0',
		'particles',
		'dmxloader',
		'vgui_controls',
		'matsys_controls',
		'tier1',
		'tier2',
		'tier3',
		'mathlib',
		'vstdlib',
		'choreoobjects',
		'steam_api',
		'bitmap',
		'vtf',
		'RT',
		'ZLIB'
	]
	if bld.env.DEST_OS == 'win32':
		base_libs += ['USER32']

	for game_name in game_list:
		game = vpc_parser.parse_vpcs( bld.env, games[game_name], '../..' )

		install_path = bld.env.LIBDIR if bld.env.DEST_OS == 'android' else (bld.env.PREFIX + '/' + game_name + '/bin')

		source = ['in_touch.cpp'] + game["sources"] + ['../../public/tier0/memoverride.cpp']
		includes = list(base_includes) + game["includes"]
		defines = [d for d in game["defines"] if d != 'PROTECTED_THINGS_ENABLE']

		bld.shlib(
			source   = source,
			target   = ('%s/%s' % (game_name, PROJECT_NAME)) if multi else PROJECT_NAME,
			name     = ('%s_%s' % (PROJECT_NAME, game_name)) if multi else PROJECT_NAME,
			features = 'c cxx',
			includes = includes,
			defines  = defines,
			use      = base_libs,
			install_path = install_path,
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx      = bld.get_taskgen_count()
		)


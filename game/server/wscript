#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os
import vpc_parser

top = '.'
PROJECT_NAME = 'server'

games = {
	'hl2': ['server_base.vpc', 'server_hl2.vpc'],
	'episodic':['server_base.vpc', 'server_episodic.vpc'],
	'hl2mp': ['server_base.vpc', 'server_hl2mp.vpc'],
	'portal': ['server_base.vpc', 'server_portal.vpc'],
	'hl1': ['server_base.vpc', 'server_hl1.vpc'],
	'hl1mp': ['server_base.vpc', 'server_hl1mp.vpc'],
	'cstrike': ['server_base.vpc', 'server_cstrike.vpc', 'nav_mesh.vpc'],
	'dod': ['server_base.vpc', 'server_dod.vpc'],
	'lostcoast': ['server_base.vpc', 'server_lostcoast.vpc'],
	'tf': [
		'server_base.vpc',
		'server_econ_base.vpc',
		'tf/tf_gcmessages_include.vpc',
		'nav_mesh.vpc',
		'server_tf.vpc'
	]
}

def options(opt):
	return

def resolve_game_list(raw_games):
	if raw_games == 'all':
		return [g for g in games.keys() if g != 'tf']
	return [g.strip() for g in raw_games.split(',') if g.strip()]

def configure(conf):
	game = conf.options.GAMES
	conf.env.GAMES = game

	conf.env.append_unique('DEFINES', ['DISABLE_STEAM=1'])

	for g in resolve_game_list(game):
		if g not in games:
			conf.fatal("Couldn't find game: " + g)

def build(bld):
	game_list = resolve_game_list(bld.env.GAMES)
	multi = len(game_list) > 1

	base_includes = [
		'.',
		'../shared',
		'../../utils/common',
		'../shared/econ',
		'NextBot',
		'../../common',
		'../../public/tier0',
		'../../public/tier1',
		'../../public'
	]

	base_libs = ['tier0','particles','dmxloader','tier1','tier2','tier3','mathlib','vstdlib','choreoobjects','steam_api']
	if bld.env.DEST_OS == 'win32':
		base_libs += ['USER32']

	for game_name in game_list:
		game = vpc_parser.parse_vpcs( bld.env, games[game_name], '../..' )

		install_path = bld.env.LIBDIR if bld.env.DEST_OS == 'android' else (bld.env.PREFIX + '/' + game_name + '/bin')

		source = game["sources"] + ['../../public/tier0/memoverride.cpp']
		includes = list(base_includes) + game["includes"]
		defines = [d for d in game["defines"] if d != 'PROTECTED_THINGS_ENABLE']

		bld.shlib(
			source   = source,
			target   = ('%s/%s' % (game_name, PROJECT_NAME)) if multi else PROJECT_NAME,
			name     = ('%s_%s' % (PROJECT_NAME, game_name)) if multi else PROJECT_NAME,
			features = 'c cxx',
			includes = includes,
			defines  = defines,
			install_path = install_path,
			use      = base_libs,
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx      = bld.get_taskgen_count()
		)

